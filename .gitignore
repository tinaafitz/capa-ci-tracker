node_modules/
dist/
.env
.env.local
.env.*.local
.DS_Store
*.log
.claude/*
# ...but do track the shared run-app skill (repo's verified way to launch the app)
!.claude/skills/
.claude/skills/*
!.claude/skills/run-app/

# SQLite database files.
# The .bak glob matters: this repo is public and the database holds real
# internal CI data (hostnames, console output, cluster URLs). A timestamped
# backup like capa-ci-tracker.db.bak-20260910 does NOT match *.db, so without
# this line a `git add -A` would publish it.
*.db
*.db-wal
*.db-shm
*.db.bak*
*.db.backup*
