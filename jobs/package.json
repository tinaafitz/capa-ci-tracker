{
  "name": "capa-ci-tracker-jobs",
  "version": "1.0.0",
  "private": true,
  "description": "CronJob scripts for CAPA CI Tracker on OpenShift",
  "scripts": {
    "ingest:jenkins": "node --import tsx jobs/ingest.ts --source=jenkins",
    "ingest:prow": "node --import tsx jobs/ingest.ts --source=prow",
    "resolution-tracker": "node --import tsx jobs/resolution-tracker.ts",
    "retention-cleanup": "node --import tsx jobs/retention-cleanup.ts",
    "streak-analyzer": "node --import tsx jobs/streak-analyzer.ts"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
