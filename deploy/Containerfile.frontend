# Containerfile.frontend
# Multi-stage build for the CAPA CI Tracker React frontend.
# Produces an nginx container serving the Vite build output.
#
# OpenShift constraint: containers run as an arbitrary non-root UID.
# nginx must write its pid and temp files to /tmp (world-writable),
# and listen on an unprivileged port (8080, not 80).
#
# Build:
#   podman build -f deploy/Containerfile.frontend -t frontend .
#
# The build context must be the repo root so that frontend/ is accessible.

# ---------------------------------------------------------------------------
# Stage 1: Build the React app
# ---------------------------------------------------------------------------
FROM node:22-alpine AS build

WORKDIR /app

# Install dependencies first (layer cache: only re-runs when lockfile changes)
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy the rest of the frontend source
COPY frontend/ .

# Build-time env: the frontend talks to PostgREST through the nginx /api/ proxy,
# so VITE_API_URL is a relative path, not a full URL.
ENV VITE_API_URL=/api

RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: Serve with nginx
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine

# Remove the default site config shipped with the nginx image.
# The real config is mounted at runtime via a ConfigMap (see
# deploy/openshift/configmap-nginx.yaml), but we copy a default
# fallback so the image is independently runnable for local testing.
RUN rm -f /etc/nginx/conf.d/default.conf

COPY deploy/nginx.conf /etc/nginx/nginx.conf

# Copy the built static assets from stage 1.
COPY --from=build /app/dist /usr/share/nginx/html

# ---------------------------------------------------------------------------
# OpenShift non-root compatibility
# ---------------------------------------------------------------------------
# OpenShift assigns an arbitrary UID at runtime (e.g. 1000620000).
# nginx needs to write its pid file and several temp directories.
# We point all of these at /tmp, which is world-writable.
#
# The nginx.conf already sets:
#   pid /tmp/nginx.pid;
#   client_body_temp_path /tmp/client_temp;
#   proxy_temp_path       /tmp/proxy_temp;
#   ...etc
#
# We also need the cache directory and the html directory to be readable.
# The default nginx image owns files as root, but they only need to be
# *read* at runtime, so no ownership change is needed for those.
#
# Create the temp directories so nginx does not fail on first request.
RUN mkdir -p /tmp/client_temp /tmp/proxy_temp /tmp/fastcgi_temp \
             /tmp/uwsgi_temp /tmp/scgi_temp && \
    chmod -R 777 /tmp/client_temp /tmp/proxy_temp /tmp/fastcgi_temp \
                 /tmp/uwsgi_temp /tmp/scgi_temp && \
    # Ensure the pid location is writable
    touch /tmp/nginx.pid && chmod 666 /tmp/nginx.pid && \
    # nginx also writes to /var/cache/nginx -- make it writable or
    # redirect via config. We make it writable as a safety net.
    chmod -R 777 /var/cache/nginx && \
    # /var/run is sometimes used for the pid; make it writable as well.
    chmod -R 777 /var/run

EXPOSE 8080

# Run as non-root. On OpenShift this is overridden by the SCC, but
# setting it here makes the image safe for local podman/docker too.
USER 1001

CMD ["nginx", "-g", "daemon off;"]
