# Containerfile.jobs
# Container for the CAPA CI Tracker CronJob scripts (ingest, resolution-tracker,
# retention-cleanup). Each OCP CronJob overrides the command at runtime.
#
# Build:
#   podman build -f deploy/Containerfile.jobs -t jobs .
#
# The build context must be the repo root so that jobs/ and supabase/ are accessible.

FROM node:22-alpine

WORKDIR /app

# Install dependencies first (layer cache).
# If package-lock.json does not exist yet, npm install falls back gracefully.
COPY jobs/package.json jobs/package-lock.json* ./
RUN npm ci --production || npm install --production

# Copy job source files.
COPY jobs/*.ts ./jobs/
COPY jobs/tsconfig.json ./jobs/

# Copy SQL migrations -- the init job or ad-hoc maintenance may need to
# apply schema changes directly against Postgres.
COPY supabase/migrations/ ./supabase/migrations/

# ---------------------------------------------------------------------------
# OpenShift non-root compatibility
# ---------------------------------------------------------------------------
# OpenShift runs containers as an arbitrary non-root UID. Node.js does not
# need root, but we explicitly set a non-root user so the image is safe
# for local testing and passes OCP security context constraints.
#
# No CMD is set here. Each CronJob manifest specifies its own command, e.g.:
#   command: ["node", "--import", "tsx", "jobs/ingest.ts", "--source=jenkins"]
# ---------------------------------------------------------------------------
USER 1001
