# .dockerignore -- Keep the build context small and exclude secrets.
#
# This file is used by both Containerfile.frontend and Containerfile.jobs.
# The build context is the repo root (not deploy/).

# Dependencies are installed inside the container; skip host copies.
node_modules
frontend/node_modules
jobs/node_modules

# Git history is not needed in images.
.git

# Documentation and design docs add no runtime value.
*.md
docs/

# Edge Functions are Deno-based and not used on OpenShift.
# The jobs/ directory contains the Node.js replacements.
supabase/functions/

# Claude Code agent configs.
.claude/

# Environment files contain secrets -- never bake into an image.
.env
.env.*
supabase/.env.local
frontend/.env.local

# IDE and OS artifacts.
.vscode/
.idea/
.DS_Store

# Supabase local dev state.
.supabase/
supabase/.temp/

# Test files and coverage reports.
coverage/
frontend/coverage/
*.test.*
*.spec.*

# Deploy manifests themselves (no reason to ship YAML inside the image).
deploy/openshift/
